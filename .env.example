# Solana RPC endpoint. The public one works for testing but is slow and rate-limited.
# Get a free key at https://www.helius.dev and use:
#   RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
RPC_URL=https://api.mainnet-beta.solana.com
# Optional: WebSocket endpoint (derived from RPC_URL if empty)
WS_URL=

# Only needed for LIVE mode. Base58 secret key of a DEDICATED hot wallet.
# Never put your main wallet here. Never commit this file.
PRIVATE_KEY=

# Jupiter swap API (free tier). If you get an API key from portal.jup.ag, set
# JUPITER_API_URL=https://api.jup.ag/swap/v1 and JUPITER_API_KEY=...
JUPITER_API_URL=https://lite-api.jup.ag/swap/v1
JUPITER_API_KEY=

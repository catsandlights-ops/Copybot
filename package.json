{
  "name": "copybot",
  "version": "0.9.3",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx src/bot.ts",
    "analyze": "tsx src/analyze.ts",
    "discover": "tsx src/discover.ts",
    "typecheck": "tsc --noEmit",
    "app": "tsx src/server.ts",
    "bundle": "node scripts/bundle.mjs",
    "desktop": "npm run bundle && electron .",
    "dist:win": "npm run bundle && electron-builder --win",
    "dist:mac": "npm run bundle && electron-builder --mac",
    "dist:linux": "npm run bundle && electron-builder --linux",
    "sign-update": "node scripts/sign-update.mjs",
    "test": "tsx --test src/*.test.ts",
    "test:fuzz": "npm run bundle && node scripts/stress/fuzz-api.mjs",
    "test:stress": "npm run bundle && node scripts/stress/run.mjs 3 --kill-every=1",
    "test:ui": "npm run bundle && node scripts/stress/ui-check.mjs",
    "test:phone": "npm run bundle && node scripts/stress/phone-check.mjs",
    "test:resume": "npm run bundle && node scripts/stress/resume-check.mjs",
    "test:all": "npm test && npm run test:fuzz && npm run test:stress && npm run test:ui && npm run test:phone && npm run test:resume"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@solana/web3.js": "^1.99.0",
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.6",
    "bs58": "^6.0.0",
    "dotenv": "^16.4.7",
    "electron": "^44.9.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "qrcode": "^1.5.4",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "viem": "2.57.11",
    "zod": "^4.6.7"
  },
  "productName": "Remora",
  "description": "Remora: a Solana and Base copy-trading bot",
  "author": "Remora",
  "main": "electron/main.cjs",
  "build": {
    "appId": "app.copybot.desktop",
    "productName": "Remora",
    "asar": false,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "dist/**",
      "ui/**",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Remora",
      "artifactName": "Remora-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.finance",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Finance",
      "artifactName": "Remora-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "catsandlights-ops",
      "repo": "copybot",
      "releaseType": "draft"
    }
  },
  "overrides": {
    "jayson": "5.0.0"
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  }
}
